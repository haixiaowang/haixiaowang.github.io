{% comment %}
  Parse-safe wrapper for al_search custom tag.
  Kept in an include so templates without the plugin can still render.
{% endcomment %}
{% al_search_assets %}
<script>
  // al_search indexes collections without an exclusion setting.
  // Filter before the search component initializes; posts use posts_in_search.
  {
    const search = document.querySelector('ninja-keys');
    search.data = search.data.filter((entry) => !['News', 'Projects'].includes(entry.section));
  }
</script>
